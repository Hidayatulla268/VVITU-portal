# VVIT Portal Environment Settings Example
# Rename this file to '.env' and fill in your values.

# Django Security
DJANGO_SECRET_KEY=vvitu-dev-fallback-key-DO-NOT-USE-in-production-replace-me-immediately-2024
DJANGO_DEBUG=True
# Comma-separated allowed hosts:
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (for PostgreSQL in production)
# DATABASE_URL=postgres://user:password@host:port/dbname

# Redis URL (for Caching & Sessions in production)
# REDIS_URL=redis://127.0.0.1:6379/1

# Real Email Sending (SMTP Configuration for College Email / Gmail / Office365)
# Set your college email credentials to send real emails to student & faculty mailboxes
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notifications@vvitu.ac.in
EMAIL_HOST_PASSWORD=your_smtp_app_password_here
DEFAULT_FROM_EMAIL="VVITU Examination Cell <notifications@vvitu.ac.in>"

# AI Chatbot API Key (optional)
# GEMINI_API_KEY=your_gemini_api_key_here
