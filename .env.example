# VVITU Portal — Environment Configuration
# Copy this file to '.env' in the project root to set environment variables.

# ── Security & Debug ──────────────────────────
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=vvitu-production-secret-key-change-this-to-a-secure-random-string-50chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# ── Database Configuration (Optional) ─────────
# DATABASE_URL=postgres://user:password@localhost:5432/vvitu_db
